# ModelMesh backend environment.
# Copy to `.env` (which is git-ignored). NEVER commit real keys.
# If no real keys are set, execution automatically uses deterministic MOCK providers.

# ---- Real provider keys (optional) ----
# Groq — https://console.groq.com  (OpenAI-compatible, fast inference)
GROQ_API_KEY= 
# OpenRouter — https://openrouter.ai  (multi-model aggregator)
OPENROUTER_API_KEY=

# ---- Server ----
MODELMESH_HOST=0.0.0.0
MODELMESH_PORT=8000
# Comma-separated allowed CORS origins for the mobile PWA dev/build servers.
MODELMESH_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Execution / failover ----
MODELMESH_REQUEST_TIMEOUT_S=30
MODELMESH_MAX_RETRIES=2
# Set false to force mock-only execution even when keys are present.
MODELMESH_ENABLE_REAL_PROVIDERS=true
