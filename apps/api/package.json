{
  "name": "@neuralforge/api",
  "version": "0.1.0",
  "private": true,
  "description": "Neural Forge orchestration backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx src/jobs/subtask.worker.ts",
    "seed": "tsx ../../scripts/seed-keys.ts",
    "test-providers": "tsx ../../scripts/test-providers.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@google/generative-ai": "^0.21.0",
    "@neuralforge/types": "workspace:*",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.34.10",
    "dotenv": "^16.4.7",
    "envalid": "^8.0.0",
    "fastify": "^4.29.0",
    "fastify-plugin": "^4.5.1",
    "groq-sdk": "^0.9.1",
    "ioredis": "^5.4.2",
    "pino": "^9.14.0",
    "socket.io": "^4.8.1",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.4.5",
    "vitest": "^2.1.8"
  }
}
