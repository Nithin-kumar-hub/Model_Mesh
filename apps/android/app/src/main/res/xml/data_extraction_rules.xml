<?xml version="1.0" encoding="utf-8"?>
<!--
  android:dataExtractionRules target (API 31+). Splits cloud backup from
  device-to-device transfer.

  The Room cache (modelmesh.db) is excluded from cloud backup for the same reason
  as backup_rules.xml: its rows are backend-owned and install-specific. It is also
  excluded from device transfer, since the cache re-syncs from the backend on the
  new device and stale ids would otherwise appear before the first refresh.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="modelmesh.db" />
        <exclude domain="database" path="modelmesh.db-shm" />
        <exclude domain="database" path="modelmesh.db-wal" />
        <exclude domain="database" path="modelmesh.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="modelmesh.db" />
        <exclude domain="database" path="modelmesh.db-shm" />
        <exclude domain="database" path="modelmesh.db-wal" />
        <exclude domain="database" path="modelmesh.db-journal" />
    </device-transfer>
</data-extraction-rules>
