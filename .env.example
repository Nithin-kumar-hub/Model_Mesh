# ─────────────────────────────────────────────────────────────
# ModelMesh environment
# Copy to .env and fill in. Everything has a working default
# except the provider keys — the stack boots with zero infra.
# ─────────────────────────────────────────────────────────────

# ── Datastores ───────────────────────────────────────────────
DATABASE_URL="postgresql://modelmesh:modelmesh@localhost:5432/modelmesh"
REDIS_URL="redis://localhost:6379"

# Backend selection.
#   PERSISTENCE=prisma  → PostgreSQL via Prisma (production)
#   PERSISTENCE=memory  → in-process store, no Postgres needed (demo/tests)
#   PERSISTENCE=auto    → try Prisma, fall back to memory (default)
PERSISTENCE=auto
#   CACHE_BACKEND=redis | memory | auto  (auto = try Redis, fall back)
CACHE_BACKEND=auto

# ── AI providers — comma-separated, multiple keys per provider ─
GEMINI_API_KEYS=""
GROQ_API_KEYS=""
TOGETHER_API_KEYS=""
MISTRAL_API_KEYS=""
OPENROUTER_API_KEYS=""

# ── Server ───────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
API_SECRET="dev-secret-change-me"
# 32+ char secret used to AES-256-GCM encrypt provider keys at rest
KEY_ENCRYPTION_SECRET="dev-encryption-secret-change-me-please"

# ── Feature flags ────────────────────────────────────────────
ENABLE_SEMANTIC_CACHE=true
ENABLE_PARALLEL_EXECUTION=true
ENABLE_VERIFICATION=true
# Deterministic offline provider so the full pipeline is demoable
# without any API keys. Auto-enables when no real keys are present.
ENABLE_MOCK_PROVIDER=true
MAX_PARALLEL_SUBTASKS=4
DEFAULT_STRATEGY="balanced"   # draft | balanced | premium

# ── Limits ───────────────────────────────────────────────────
TASK_TIMEOUT_MS=60000
MAX_FILE_BYTES=20971520
MAX_ATTEMPTS_PER_SUBTASK=3
